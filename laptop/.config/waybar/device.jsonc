{
  "modules-right": [
    "pulseaudio",
    "custom/battery",
    "network",
    "cpu",
    "memory",
    "tray",
    "custom/power"
  ],
  "custom/battery": {
    "exec": "~/.config/waybar/scripts/t480-battery.sh",
    "return-type": "json",
    "interval": 10,
    "format": "{}",
    "tooltip": true
  }
}
