{
  "layer": "top",
  "position": "top",
  "include": ["device.jsonc"],
  "modules-left": [
        "hyprland/workspaces"
    ],
  "modules-center": ["clock"],
  "hyprland/workspaces": {
    "format": "{name}: {icon}",
    "format-icons": {
      "active": "",
      "default": ""
    }
  },
  "clock": {
    "interval": 1,
    "timezone": "America/Chicago",
    "format": "{:%I:%M %p}",
    "tooltip": true,
    "tooltip-format": "{:%A | %B %d, %Y}"
  },
  "network": {
    "format-wifi": "󰤢 ",
    "format-ethernet": "󰈀 ",
    "format-disconnected": "󰤠 ",
    "interval": 5,
    "tooltip": true,
    "tooltip-format": "{ipaddr}",
    "tooltip-format-wifi": "{essid} ({signalStrength}%): {ipaddr}",
    "tooltip-format-ethernet": "{ifname}: {ipaddr}",
    "tooltip-format-disconnected": "Disconnected",
    "on-click": "kitty --class float_nmtui -e nmtui"
  },
  "cpu": {
    "interval": 2,
    "format": " {usage}%",
    "tooltip": true,
    "on-click": "kitty --class float_btop -e btop"
  },
  "memory": {
    "interval": 30,
    "format": " {percentage}%",
    "tooltip": true,
    "tooltip-format": "{used:0.1f}G/{total:0.1f}G",
    "on-click": "kitty --class float_btop -e btop"
  },
  "pulseaudio": {
    "format": "{icon}{volume}%",
    "format-muted": "",
    "format-icons": {
      "default": ["", "", " "]
    },
    "on-click": "pavucontrol"
  }
}
