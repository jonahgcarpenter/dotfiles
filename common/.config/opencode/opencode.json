{
  "$schema": "https://opencode.ai/config.json",
  "formatter": true,
  "providers": {
    "vllm": {
      "name": "vLLM",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://192.168.4.189:8000/v1",
        "apiKey": "{env:VLLM_API_KEY}"
      },
      "models": {
        "qwen3.8-27b-uncensored-exl3": {
          "modelID": "qwen3.8-27b-uncensored-exl3",
          "name": "Qwen 3.8 27B Uncensored",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 262144
          }
        }
      }
    },
    "oswald": {
      "name": "Oswald",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://192.168.4.235:8080/v1",
        "apiKey": "{env:OSWALD_API_KEY}"
      },
      "models": {
        "oswald": {
          "modelID": "oswald",
          "name": "Oswald",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 262144
          }
        }
      }
    }
  },
  "plugin": ["@slkiser/opencode-quota@latest"]
}
